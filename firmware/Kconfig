mainmenu "VAMS management firmware"

source "Kconfig.zephyr"

config VAMS_WATCHDOG_EXPIRY_TEST
	bool "Deliberately allow the first watchdog deadline to expire"
	default n
	help
	  Exercise watchdog recovery by withholding pets until the first
	  watchdog-initiated management reset has completed.

config VAMS_SCHEDULER_TEST_DELAY_MS
	int "Test-only delay before scheduler dispatch"
	default 0
	range 0 1000
	help
	  Delay dispatch to exercise deterministic queued-command expiry. Keep
	  this zero in the normal firmware configuration.

config VAMS_OVERLOAD_TEST
	bool "Inject deterministic diagnostic queue pressure"
	default n
	help
	  Fill the bounded event and heartbeat queues before their consumers
	  start so the overload counters and nonblocking drop policy can be
	  validated. Keep this disabled in the normal firmware configuration.
