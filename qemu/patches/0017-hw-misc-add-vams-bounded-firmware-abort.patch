@@ -1652,6 +1703,9 @@
         VMSTATE_UINT32_V(bridge_completion_pos, VamsPcieState, 3),
         VMSTATE_BOOL_V(bridge_inflight, VamsPcieState, 3),
         VMSTATE_BOOL_V(bridge_waiting_final, VamsPcieState, 8),
+        VMSTATE_UINT8_ARRAY_V(bridge_control, VamsPcieState,
+                              VAMS_COMPLETION_SIZE, 9),
+        VMSTATE_UINT32_V(bridge_control_pos, VamsPcieState, 9),
         VMSTATE_BOOL_V(bridge_discard_completion, VamsPcieState, 3),
         VMSTATE_INT64_V(command_deadline_ns, VamsPcieState, 5),
         VMSTATE_INT64_V(engine_finish_ns, VamsPcieState, 5),
@@ -1704,6 +1758,8 @@
     s->cq_error = false;
     memset(&s->bridge_submission, 0, sizeof(s->bridge_submission));
     s->bridge_completion_pos = 0;
+    memset(s->bridge_control, 0, sizeof(s->bridge_control));
+    s->bridge_control_pos = 0;
     s->bridge_inflight = false;
     s->bridge_waiting_final = false;
     s->bridge_discard_completion = false;
