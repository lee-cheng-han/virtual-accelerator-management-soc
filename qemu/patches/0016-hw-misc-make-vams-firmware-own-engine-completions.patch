+static bool vams_pcie_report_engine_result(
+    VamsPcieState *s, const struct vams_completion *completion, bool discard)
+{
+    int written;
+
+    g_assert(!s->bridge_inflight);
+    g_assert(!s->bridge_discard_completion);
+    if (!qemu_chr_fe_backend_connected(&s->command_chr)) {
+        vams_pcie_set_error(s, VAMS_ERROR_DMA | VAMS_ERROR_QUEUE);
+        return false;
+    }
+
+    s->bridge_inflight = !discard;
+    s->bridge_waiting_final = !discard;
+    s->bridge_discard_completion = discard;
+    written = qemu_chr_fe_write_all(&s->command_chr,
+                                    (const uint8_t *)completion,
+                                    sizeof(*completion));
+    if (written != sizeof(*completion)) {
+        s->bridge_inflight = false;
+        s->bridge_waiting_final = false;
+        s->bridge_discard_completion = false;
+        vams_pcie_set_error(s, VAMS_ERROR_DMA | VAMS_ERROR_QUEUE);
+        return false;
+    }
+    qemu_chr_fe_accept_input(&s->command_chr);
+    vams_pcie_check_invariants(s);
+    return true;
+}
+
+static void vams_pcie_abort_engine_to_firmware(VamsPcieState *s,
+                                                uint16_t error_code)
+{
+    struct vams_completion *completion =
+        (struct vams_completion *)s->bridge_completion;
+
+    vams_pcie_cancel_engine(s);
+    completion->status = cpu_to_le16(VAMS_STATUS_RESET);
+    completion->error_code = cpu_to_le16(error_code);
+    completion->bytes_processed = 0;
+    completion->result_crc = 0;
+    completion->device_timestamp = cpu_to_le64(
+        qemu_clock_get_us(QEMU_CLOCK_VIRTUAL));
+    vams_pcie_report_engine_result(s, completion, true);
+}
