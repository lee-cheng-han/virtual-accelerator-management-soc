+static void vams_command_notify_reset(VamsMgmtState *s)
+{
+    const struct vams_submission *submission =
+        (const struct vams_submission *)s->command_submission;
+    struct vams_completion completion = { 0 };
+    int written;
+
+    if (!s->command_active) {
+        return;
+    }
+    completion.command_id = submission->command_id;
+    completion.status = cpu_to_le16(VAMS_STATUS_RESET);
+    completion.error_code = cpu_to_le16(VAMS_ERR_RESET);
+    completion.user_cookie = submission->user_cookie;
+    completion.device_timestamp = cpu_to_le64(
+        qemu_clock_get_us(QEMU_CLOCK_VIRTUAL));
+    written = qemu_chr_fe_backend_connected(&s->command_chr) ?
+        qemu_chr_fe_write_all(&s->command_chr, (const uint8_t *)&completion,
+                              sizeof(completion)) : -1;
+    if (written == sizeof(completion)) {
+        s->reset_notify_count = vams_sat_inc(s->reset_notify_count);
+        qemu_chr_fe_accept_input(&s->command_chr);
+    } else {
+        s->reset_notify_fail_count =
+            vams_sat_inc(s->reset_notify_fail_count);
+        s->command_status |= VAMS_COMMAND_PROTOCOL_ERROR;
+    }
+}
