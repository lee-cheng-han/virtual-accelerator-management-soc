+static uint32_t vams_pcie_sat_inc(uint32_t value)
+{
+    return value == UINT32_MAX ? value : value + 1;
+}
+
+static uint32_t vams_pcie_cq_occupancy(const VamsPcieState *s)
+{
+    if (!s->cq_depth) {
+        return 0;
+    }
+    return (s->cq_tail - s->cq_head) & (s->cq_depth - 1);
+}
+
+static void vams_pcie_update_cq_backpressure(VamsPcieState *s)
+{
+    uint32_t occupancy = vams_pcie_cq_occupancy(s);
+
+    s->cq_high_water = MAX(s->cq_high_water, occupancy);
+    if (!(s->cq_control & VAMS_QUEUE_ENABLE) ||
+        !s->cq_watermark_high) {
+        s->cq_backpressure = false;
+        return;
+    }
+    if (!s->cq_backpressure && occupancy >= s->cq_watermark_high) {
+        s->cq_backpressure = true;
+        s->cq_backpressure_count =
+            vams_pcie_sat_inc(s->cq_backpressure_count);
+    } else if (s->cq_backpressure &&
+               occupancy <= s->cq_watermark_low) {
+        s->cq_backpressure = false;
+    }
+}
